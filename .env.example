# PhotoPhoenix settings as environment variables. Copy to .env (git-ignored) and edit.
# Same settings as config.example.toml; .env and PHOTOPHOENIX_* variables override config.toml.
# Lists are separated with ';'. No API keys, accounts or online services are needed.

PHOTOPHOENIX_SOURCE_DIR=
PHOTOPHOENIX_OUTPUT_DIR=
PHOTOPHOENIX_DONOR_DIRS=
PHOTOPHOENIX_COPY_SEARCH_DIRS=
PHOTOPHOENIX_DATA_DIR=local
PHOTOPHOENIX_TEMP_DIR=local/tmp
PHOTOPHOENIX_WORKERS=4
PHOTOPHOENIX_MAX_WORKERS=6
PHOTOPHOENIX_MIN_FREE_RAM_GB=3.0
PHOTOPHOENIX_LOW_PRIORITY=true
PHOTOPHOENIX_SKIP_DIRS=$recycle.bin;system volume information
# Optional: use a config file somewhere else
# PHOTOPHOENIX_CONFIG=
