# STOPgap settings as environment variables. Copy to .env (git-ignored) and edit.
# Same settings as config.example.toml; .env and STOPGAP_* variables override config.toml.
# Lists are separated with ';'. No API keys, accounts or online services are needed.

STOPGAP_SOURCE_DIR=
STOPGAP_OUTPUT_DIR=
STOPGAP_DONOR_DIRS=
STOPGAP_COPY_SEARCH_DIRS=
STOPGAP_DATA_DIR=local
STOPGAP_TEMP_DIR=local/tmp
STOPGAP_WORKERS=4
STOPGAP_MAX_WORKERS=6
STOPGAP_MIN_FREE_RAM_GB=3.0
STOPGAP_LOW_PRIORITY=true
STOPGAP_SKIP_DIRS=$recycle.bin;system volume information
# Optional: use a config file somewhere else
# STOPGAP_CONFIG=
